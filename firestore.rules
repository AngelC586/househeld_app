rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(householdID) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)
        );
    }

    function isManager(householdID) {
      return isMember(householdID)
        && get(
          /databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)
        ).data.memberRole == 'manager';
    }

    function validAvatar(data) {
      return (
        !('avatarSymbol' in data)
        || (
          data.avatarSymbol is string
          && data.avatarSymbol.size() > 0
          && data.avatarSymbol.size() <= 32
        )
      )
      && (
        !('avatarColor' in data)
        || (
          data.avatarColor is int
          && data.avatarColor >= 0
          && data.avatarColor <= 4294967295
        )
      );
    }

    // Check whether this transaction creates a household
    // owned by the signed-in user.
    function createsHousehold(householdID) {
      return signedIn()
        && !exists(
          /databases/$(database)/documents/households/$(householdID)
        )
        && getAfter(
          /databases/$(database)/documents/households/$(householdID)
        ).data.creatorID == request.auth.uid;
    }

    // The user must already have a profile without a household.
    function hasNoHousehold() {
      let profile = get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;

      return profile.get('householdID', null) == null
        || profile.get('householdID', null) == '';
    }

    // Check the profile's household link after the transaction.
    function profileLinksTo(householdID) {
      return getAfter(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.householdID == householdID;
    }

    // Check the creator's membership after the transaction.
    function hasManagerMembershipAfter(householdID) {
      let member = getAfter(
        /databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)
      ).data;

      return member.userID == request.auth.uid
        && member.householdID == householdID
        && member.memberRole == 'manager';
    }

    function validProfile(data) {
      return data.keys().hasOnly([
          'username',
          'email',
          'displayName',
          'householdID',
          'avatarSymbol',
          'avatarColor'
        ])
        && data.username is string
        && data.username.size() <= 30
        && data.email is string
        && data.displayName is string
        && data.displayName.size() <= 100
        && validAvatar(data)
        && (
          data.get('householdID', null) == null
          || data.get('householdID', null) is string
        );
    }

    // Validate joining an existing household
    function joinsHousehold(householdID) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/households/$(householdID)
        )
        // Prevent new users from joining during household deletion:
        && !exists(
          /databases/$(database)/documents/households/$(householdID)/deletionLocks/active
        )
        && hasNoHousehold()
        && profileLinksTo(householdID)
        && getAfter(
          /databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)
        ).data.userID == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)
        ).data.householdID == householdID
        && getAfter(
          /databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)
        ).data.memberRole == 'member';
    }

    match /users/{userID} {
      allow read: if signedIn()
        && (
          request.auth.uid == userID
          || (
            resource.data.get('householdID', null) is string
            && isManager(
              resource.data.get('householdID', '')
            )
          )
        );

      // Signup creates a profile without household membership.
      allow create: if signedIn()
        && request.auth.uid == userID
        && validProfile(request.resource.data)
        && request.resource.data.get('householdID', null) == null;

      // Keep the existing household link, or establish one
      // through a valid create or join transaction.
      allow update: if signedIn()
        && request.auth.uid == userID
        && validProfile(request.resource.data)
        && (
            request.resource.data.email == resource.data.email
            || request.resource.data.email == request.auth.token.email
          )
        && (
          request.resource.data.get('householdID', null)
            == resource.data.get('householdID', null)
          || (
            (
              resource.data.get('householdID', null) == null
              || resource.data.get('householdID', null) == ''
            )
            && request.resource.data.householdID is string
            && request.resource.data.householdID.size() > 0
            && (
              (
                createsHousehold(request.resource.data.householdID)
                && hasManagerMembershipAfter(
                  request.resource.data.householdID
                )
              )
              || joinsHousehold(request.resource.data.householdID)
            )
          )
        );

      // Additional 'allow update' rule:
      // Authorizes updates for leaving a household or removing a member
      allow update: if signedIn()
        && validProfile(request.resource.data)
        && (
          request.resource.data.email == resource.data.email
          || request.resource.data.email == request.auth.token.email
        )
        && resource.data.get('householdID', null) is string
        && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['householdID'])
        && request.resource.data.get('householdID', null) == null
        && !existsAfter(
          /databases/$(database)/documents/households/$(resource.data.householdID)/members/$(userID)
        )
        && (
          request.auth.uid == userID
          || isManager(resource.data.householdID)
        );

      // Allows for account deletion:
      allow delete: if signedIn()
        && request.auth.uid == userID
        && (
          // User does not currently belong to a household.
          resource.data.get('householdID', null) == null
          ||
          (
            // If they belong to a household,
            // membership must also be deleted.
            resource.data.get('householdID', null) is string
            && !existsAfter(
              /databases/$(database)/documents/households/$(resource.data.householdID)/members/$(userID)
            )
            && (
              // Non-Managers do not change managerCount:
              get(
                /databases/$(database)/documents/households/$(resource.data.householdID)/members/$(userID)
              ).data.memberRole != 'manager'
              ||
              (
                // A departing Manager must leave at least one other manager:
                get(
                  /databases/$(database)/documents/households/$(resource.data.householdID)
                ).data.managerCount > 1
                && getAfter(
                  /databases/$(database)/documents/households/$(resource.data.householdID)
                ).data.managerCount
                  ==
                  get(
                    /databases/$(database)/documents/households/$(resource.data.householdID)
                  ).data.managerCount - 1
              )
            )
          )
        );
    }

    match /households/{householdID} {

      // Membership role used for Stuff permissions.
      function stuffMemberRole() {
        return get(
          /databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)
        ).data.memberRole;
      }

      function canManageSharedStuff() {
        return signedIn()
          && stuffMemberRole() in ['manager', 'member'];
      }

      function canManagePrivateStuff(ownerID) {
        return signedIn()
          && request.auth.uid == ownerID
          && stuffMemberRole() in ['manager', 'member', 'child'];
      }

      // Manager check used for household deletion:
      function isDeletingManager() {
        return isManager(householdID)
          && exists(
            /databases/$(database)/documents/households/$(householdID)/deletionLocks/active
          );
      }

      // Record former members to be able to remove them from a household
      // while keeping their private stuff list and items:
      match /formerMembers/{memberID} {

        allow get, list: if isManager(householdID);

        allow create, update: if signedIn()
          && (
            request.auth.uid == memberID
            || isManager(householdID)
          )
          && request.resource.data.keys().hasOnly([
            'userID',
            'departedAt'
          ])
          && request.resource.data.userID == memberID
          && request.resource.data.departedAt == request.time
          && exists(
            /databases/$(database)/documents/households/$(householdID)/members/$(memberID)
          )
          && !existsAfter(
            /databases/$(database)/documents/households/$(householdID)/members/$(memberID)
          )
          && (
            !existsAfter(
              /databases/$(database)/documents/users/$(memberID)
            )
            ||
            getAfter(
              /databases/$(database)/documents/users/$(memberID)
            ).data.get('householdID', null) == null
          );

        allow delete: if isDeletingManager();
      }
      
      // Household deletion activation and markers:
      match /deletionLocks/{lockID} {
        allow get: if lockID == 'active'
          && isManager(householdID);

        allow create: if lockID == 'active'
          && isManager(householdID)
          && request.resource.data.keys().hasAll([
            'startedBy',
            'startedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'startedBy',
            'startedAt'
          ])
          && request.resource.data.startedBy == request.auth.uid
          && request.resource.data.startedAt == request.time;

        allow delete: if lockID == 'active'
          && isDeletingManager()
          && !existsAfter(
            /databases/$(database)/documents/households/$(householdID)
          );
      }

      // Validate the fields saved by StuffItem.toMap().
      function validStuffItem(data, expectedListType, expectedOwner) {
        let fields = [
          'itemName',
          'itemDescription',
          'itemStatus',
          'listType',
          'ownerMemberID'
        ];

        return data.keys().hasAll(fields)
          && data.keys().hasOnly(fields)
          && data.itemName is string
          && data.itemName.size() > 0
          && data.itemName.size() <= 200
          && data.itemDescription is string
          && data.itemStatus in [
            'available',
            'low',
            'out_of_stock'
          ]
          && data.listType == expectedListType
          && data.ownerMemberID == expectedOwner;
      }

      // Shared household items.
      match /householdItemsLists/{stuffListID}/items/{itemID} {
        allow read: if stuffListID == 'default'
          && isMember(householdID);

        allow create: if stuffListID == 'default'
          && canManageSharedStuff()
          && validStuffItem(request.resource.data, 'household', '');

        allow update: if stuffListID == 'default'
          && canManageSharedStuff()
          && validStuffItem(request.resource.data, 'household', '')
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'itemName',
                'itemDescription',
                'itemStatus'
              ]);

        allow delete: if stuffListID == 'default'
          && canManageSharedStuff();

        allow list, delete: if isDeletingManager();
      }

      // Private items belonging to one household member.
      match /members/{ownerID}/personalItemsLists/{stuffListID}/items/{itemID} {
        allow read: if stuffListID == 'default'
          && canManagePrivateStuff(ownerID);

        allow create: if stuffListID == 'default'
          && canManagePrivateStuff(ownerID)
          && validStuffItem(request.resource.data, 'private', ownerID);

        allow update: if stuffListID == 'default'
          && canManagePrivateStuff(ownerID)
          && validStuffItem(request.resource.data, 'private', ownerID)
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'itemName',
                'itemDescription',
                'itemStatus'
              ]);

        allow delete: if stuffListID == 'default'
          && canManagePrivateStuff(ownerID);

        allow list, delete: if isDeletingManager();
      }

      allow get: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'householdName',
          'creatorID',
          'managerCount'
        ])
        && request.resource.data.householdName is string
        && request.resource.data.householdName.size() > 0
        && request.resource.data.householdName.size() <= 100
        && request.resource.data.creatorID == request.auth.uid
        && request.resource.data.managerCount == 1
        && hasNoHousehold()
        && profileLinksTo(householdID)
        && hasManagerMembershipAfter(householdID);

      allow update: if isManager(householdID)
        && request.resource.data.keys().hasOnly([
          'householdName',
          'creatorID',
          'managerCount'
        ])
        && request.resource.data.creatorID
            == resource.data.creatorID
        && request.resource.data.householdName is string
        && request.resource.data.householdName.size() > 0
        && request.resource.data.householdName.size() <= 100
        && resource.data.managerCount is int
        && request.resource.data.managerCount is int
        && request.resource.data.managerCount >= 1
        && (
          (
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'householdName'
              ])
          )
          ||
          (
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'managerCount'
              ])
            && (
              request.resource.data.managerCount
                == resource.data.managerCount + 1
              ||
              request.resource.data.managerCount
                == resource.data.managerCount - 1
            )
          )
        );

      allow delete: if isDeletingManager()
        && !existsAfter(
          /databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.get('householdID', null) == null
        && !existsAfter(
          /databases/$(database)/documents/households/$(householdID)/deletionLocks/active
        );

      match /members/{memberID} {
        allow read: if isMember(householdID)
          || (signedIn() && memberID == request.auth.uid);

        // Creators become Managers; people joining become Members.
        allow create: if signedIn()
          && memberID == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'userID',
            'householdID',
            'memberRole',
            'displayName',
            'avatarSymbol',
            'avatarColor'
          ])
          && validAvatar(request.resource.data)
          && request.resource.data.userID == request.auth.uid
          && request.resource.data.householdID == householdID
          && request.resource.data.displayName is string
          && request.resource.data.displayName == getAfter(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.displayName
          && (
            (
              request.resource.data.memberRole == 'manager'
              && createsHousehold(householdID)
              && hasNoHousehold()
              && profileLinksTo(householdID)
            )
            || (
              request.resource.data.memberRole == 'member'
              && joinsHousehold(householdID)
            )
          );

        allow update: if isMember(householdID)
          && request.resource.data.userID
              == resource.data.userID
          && request.resource.data.householdID
              == resource.data.householdID
          && request.resource.data.keys().hasOnly([
            'userID',
            'householdID',
            'memberRole',
            'displayName',
            'avatarSymbol',
            'avatarColor'
          ])
          && validAvatar(request.resource.data)
          && (
            (
              // A user can update their own display name and avatar
              request.auth.uid == memberID
              && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly([
                  'displayName',
                  'avatarSymbol',
                  'avatarColor'
                ])
              && request.resource.data.get('displayName', '')
                  == getAfter(
                    /databases/$(database)/documents/users/$(memberID)
                  ).data.displayName
              && request.resource.data.get('avatarSymbol', null)
                  == getAfter(
                    /databases/$(database)/documents/users/$(memberID)
                  ).data.get('avatarSymbol', null)
              && request.resource.data.get('avatarColor', null)
                  == getAfter(
                    /databases/$(database)/documents/users/$(memberID)
                  ).data.get('avatarColor', null)
            )
            ||
            (
              // Managers can change member roles, including their own,
              // as long there's at least 1 other existing manager.
              isManager(householdID)
              && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly([
                  'memberRole'
                ])
              && request.resource.data.memberRole in [
                'manager',
                'member',
                'child'
              ]
              && request.resource.data.memberRole
                  != resource.data.memberRole
              && getAfter(
                /databases/$(database)/documents/households/$(householdID)
              ).data.managerCount
                  ==
                  get(
                    /databases/$(database)/documents/households/$(householdID)
                  ).data.managerCount
                  +
                  (
                    request.resource.data.memberRole == 'manager'
                      ? 1
                      : 0
                  )
                  -
                  (
                    resource.data.memberRole == 'manager'
                      ? 1
                      : 0
                  )
            )
          );

        // Allows for member removal and leaving:
        allow delete: if isMember(householdID)
          && existsAfter(
            /databases/$(database)/documents/households/$(householdID)/formerMembers/$(memberID)
          )
          && (
            // Managers may remove other household members:
            isManager(householdID)
            ||
            // Ordinary Members may leave voluntarily:
            (
              request.auth.uid == memberID
              && resource.data.memberRole == 'member'
            )
          )
          && getAfter(
            /databases/$(database)/documents/users/$(memberID)
          ).data.get('householdID', null) == null
          && (
            (
              // Removing a Manager requires decrementing the
              // household's Manager count without reaching zero:
              resource.data.memberRole == 'manager'
              && getAfter(
                /databases/$(database)/documents/households/$(householdID)
              ).data.managerCount
                ==
                get(
                  /databases/$(database)/documents/households/$(householdID)
                ).data.managerCount - 1
              && getAfter(
                /databases/$(database)/documents/households/$(householdID)
              ).data.managerCount >= 1
            )
            ||
            (
              // Removing a Member or Child leaves the
              // Manager count unchanged:
              resource.data.memberRole != 'manager'
              && getAfter(
                /databases/$(database)/documents/households/$(householdID)
              ).data.managerCount
                ==
                get(
                  /databases/$(database)/documents/households/$(householdID)
                ).data.managerCount
            )
          );

        // Allows for deleting the final manager during household deletion:
        allow delete: if isDeletingManager()
          && memberID == request.auth.uid
          && resource.data.memberRole == 'manager'
          && !existsAfter(
            /databases/$(database)/documents/households/$(householdID)
          )
          && existsAfter(
            /databases/$(database)/documents/households/$(householdID)/formerMembers/$(memberID)
          )
          && getAfter(
            /databases/$(database)/documents/users/$(memberID)
          ).data.get('householdID', null) == null;

        // Allows for account deletion:
        allow delete: if signedIn()
          && request.auth.uid == memberID
          && !existsAfter(
            /databases/$(database)/documents/users/$(memberID)
          )
          && (
            (
              resource.data.memberRole != 'manager'
              && getAfter(
                /databases/$(database)/documents/households/$(householdID)
              ).data.managerCount
                ==
                get(
                  /databases/$(database)/documents/households/$(householdID)
                ).data.managerCount
            )
            ||
            (
              resource.data.memberRole == 'manager'
              && get(
                /databases/$(database)/documents/households/$(householdID)
              ).data.managerCount > 1
              && getAfter(
                /databases/$(database)/documents/households/$(householdID)
              ).data.managerCount
                ==
                get(
                  /databases/$(database)/documents/households/$(householdID)
                ).data.managerCount - 1
            )
          );

        match /personalItemsLists/{listID} {
          // Other household members cannot read this private list.
          allow read: if signedIn()
            && memberID == request.auth.uid
            && isMember(householdID);

          // Initialize the user's private list when creating or joining.
            allow create: if signedIn()
              && memberID == request.auth.uid
              && listID == 'default'
              && (
                createsHousehold(householdID)
                || joinsHousehold(householdID)
              )
              && request.resource.data.keys().hasOnly([
                'listName', 'listVisibility', 'ownerMemberID'
              ])
              && request.resource.data.listName == 'Personal Items'
              && request.resource.data.listVisibility == 'private'
              && request.resource.data.ownerMemberID == request.auth.uid;

            // This update rule allows users to re-join a household:
            allow update: if signedIn()
              && memberID == request.auth.uid
              && listID == 'default'
              && joinsHousehold(householdID)
              && request.resource.data.keys().hasOnly([
                'listName',
                'listVisibility',
                'ownerMemberID'
              ])
              && request.resource.data.listName == 'Personal Items'
              && request.resource.data.listVisibility == 'private'
              && request.resource.data.ownerMemberID == request.auth.uid;

            allow list, delete: if isDeletingManager();
          }
        }

      match /householdItemsLists/{listID} {
        allow read: if isMember(householdID);

        allow create: if listID == 'default'
          && createsHousehold(householdID)
          && request.resource.data.keys().hasOnly([
            'listName', 'listVisibility'
          ])
          && request.resource.data.listName == 'Household Items'
          && request.resource.data.listVisibility == 'shared';

        allow delete: if isDeletingManager();
      }

      
      match /groceryLists/{groceryListID} {

        function canManageSharedGroceryList() {
          return isMember(householdID)
            && get(/databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)).data.memberRole in ['manager', 'member'];
        }

        function groceryListPath() {
          return /databases/$(database)/documents/households/$(householdID)/groceryLists/$(groceryListID);
        }

        function validGroceryVisibility(data) {
          return data.groceryListVisibility in ['shared', 'restricted']
            && data.visibleMemberIDs is list
            && data.visibleMemberIDs.size() <= 8
            && data.visibleMemberIDs.toSet().size()
                == data.visibleMemberIDs.size()
            && (
              data.groceryListVisibility == 'restricted'
              || data.visibleMemberIDs == []
            );
        }

        function validGroceryList(data) {
          let fields = [
            'groceryListName',
            'groceryListStatus',
            'groceryListDescription',
            'groceryListVisibility',
            'ownerMemberID',
            'visibleMemberIDs',
            'groceryItemsRevision'
          ];

          return data.keys().hasAll(fields)
            && data.keys().hasOnly(fields)
            && data.groceryListName is string
            && data.groceryListName.size() > 0
            && data.groceryListName.size() <= 200
            && data.groceryListDescription is string
            && data.groceryItemsRevision is int
            && data.groceryItemsRevision >= 0
            && data.groceryListStatus in [
              'incomplete',
              'complete',
              'defaultComplete',
              'completeNoReset'
            ]
            && validGroceryVisibility(data);
        }

        function validDefaultGroceryList(data) {
          return validGroceryList(data)
            && data.groceryListVisibility == 'shared'
            && data.ownerMemberID == null
            && data.visibleMemberIDs == []
            && data.groceryListStatus in [
              'incomplete',
              'defaultComplete',
              'completeNoReset'
            ];
        }

        function validCustomGroceryList(data) {
          return validGroceryList(data)
            && data.groceryListStatus in ['incomplete', 'complete']
            && data.ownerMemberID is string
            && data.ownerMemberID.size() > 0
            && data.ownerMemberID != 'default';
        }

        function validGroceryRevisionUpdate() {
          let oldRevision = resource.data.groceryItemsRevision;
          let newRevision = request.resource.data.groceryItemsRevision;

          return oldRevision is int
            && newRevision is int
            && (
              newRevision == oldRevision
              || newRevision == oldRevision + 1
            );
        }

        // Read default-list documents that were  
        // created before new attributes were added:
        function canViewGroceryList(data) {
          return isMember(householdID)
            && (
              groceryListID == 'default'
              || data.get('groceryListVisibility', '') == 'shared'
              || data.get('ownerMemberID', null) == request.auth.uid
              || request.auth.uid in data.get('visibleMemberIDs', [])
            );
        }

        function canViewParentList() {
          return exists(groceryListPath())
            && canViewGroceryList(get(groceryListPath()).data);
        }

        function canEditGroceryItems(data) {
          let role = get(/databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)).data.memberRole;

          return canViewGroceryList(data)
            && (role in ['manager', 'member'] || (
              role == 'child'
              && groceryListID == 'personal_' + request.auth.uid
              && data.groceryListVisibility == 'restricted'
              && data.ownerMemberID == request.auth.uid
              && data.visibleMemberIDs == []
            ));
        }

        function canEditParentListItems() {
          return signedIn()
          && exists(groceryListPath())
          && canEditGroceryItems(get(groceryListPath()).data);
        }

        function canCreateItemInNewList() {
          return !exists(groceryListPath())
            && existsAfter(groceryListPath())
            && isMember(householdID)
            && validCustomGroceryList(
              getAfter(groceryListPath()).data
            )
            && getAfter(groceryListPath()).data.ownerMemberID
                == request.auth.uid;
        }

        // Reserve personal_IDs for the owner's automatic private list
        function validPersonalGroceryList(data) {
          return !groceryListID.matches('personal_.*')
          || (
            groceryListID == 'personal_' + request.auth.uid
            && data.ownerMemberID == request.auth.uid
            && data.groceryListVisibility == 'restricted'
            && data.visibleMemberIDs == []
          );
        }

        function canCreateCustomGroceryList(data) {
          return canManageSharedGroceryList() 
          || (isMember(householdID) && get(
            /databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)
          ).data.memberRole == 'child'
          && groceryListID == 'personal_' + request.auth.uid
          && data.ownerMemberID == request.auth.uid
          && data.groceryListVisibility == 'restricted'
          && data.visibleMemberIDs == []
          && data.groceryListStatus == 'incomplete'
          && data.groceryItemsRevision == 0
          );
        }

        function canUpdateGroceryList(data) {
          return canManageSharedGroceryList() 
          || ( isMember(householdID) && get(
            /databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)
          ).data.memberRole == 'child'
          && groceryListID == 'personal_' + request.auth.uid
          && data.ownerMemberID == request.auth.uid
          && data.groceryListVisibility == 'restricted'
          && data.visibleMemberIDs == []
          && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'groceryListName',
            'groceryListDescription',
            'groceryListStatus',
            'groceryItemsRevision'
          ])
          );
        }

        function isGroceryListOwner() {
          return signedIn()
            && resource.data.get('ownerMemberID', null)
                == request.auth.uid;
        }

        // This accepts the original seven fields, plus
        // the new optional purchased-quantity field:
        function validGroceryItem(data) {
          let originalFields = [
            'groceryItemName',
            'groceryItemType',
            'groceryItemQuantity',
            'groceryItemStatus',
            'groceryItemDescription',
            'sourceFoodItemID',
            'sourceHouseholdItemID'
          ];

          return data.keys().hasAll(originalFields)
            && data.keys().hasOnly([
              'groceryItemName',
              'groceryItemType',
              'groceryItemQuantity',
              'groceryItemStatus',
              'groceryItemDescription',
              'sourceFoodItemID',
              'sourceHouseholdItemID',
              'groceryItemPurchasedQuantity']
            )
            && data.groceryItemName is string
            && data.groceryItemName.size() > 0
            && data.groceryItemName.size() <= 200
            && data.groceryItemType is string
            && data.groceryItemDescription is string
            && data.groceryItemQuantity is int
            && data.groceryItemQuantity >= 0
            && data.get('groceryItemPurchasedQuantity', 0) is int
            && data.get('groceryItemPurchasedQuantity', 0) >= 0
            && (
              (
                data.groceryItemStatus == 'unpurchased'
                && data.groceryItemQuantity > 0
                && data.get('groceryItemPurchasedQuantity', 0) == 0
              )
              ||
              (
                data.groceryItemStatus == 'purchased'
                && data.groceryItemQuantity == 0
                && data.get('groceryItemPurchasedQuantity', 0) >= 0
              )
            )
            && (
              data.sourceFoodItemID == null
              || (
                data.sourceFoodItemID is string
                && data.sourceFoodItemID.size() > 0
              )
            )
            && (
              data.sourceHouseholdItemID == null
              || (
                data.sourceHouseholdItemID is string
                && data.sourceHouseholdItemID.size() > 0
              )
            )
            && !(
              data.sourceFoodItemID != null
              && data.sourceHouseholdItemID != null
            );
        }

        // Only the owner can manage custom list data
        // The default list belongs to the household
        allow get, list: if canViewGroceryList(resource.data);

        // Also let members check whether their automatic private list exists
        allow get: if (isMember(householdID) && groceryListID == 'personal_' + request.auth.uid && !exists(groceryListPath())) ||
                  canViewGroceryList(resource.data);

        allow create: if (
          groceryListID == 'default'
          && createsHousehold(householdID)
          && validDefaultGroceryList(request.resource.data)
          && request.resource.data.groceryListName == 'Grocery List'
          && request.resource.data.groceryItemsRevision == 0
        ) || (
          groceryListID != 'default'
          && isMember(householdID)
          && canCreateCustomGroceryList(request.resource.data)
          && validCustomGroceryList(request.resource.data)
          && request.resource.data.ownerMemberID == request.auth.uid
          && request.resource.data.groceryListStatus in [
            'incomplete',
            'complete'
          ]
          && (
            request.resource.data.groceryListStatus != 'complete'
            || request.resource.data.groceryItemsRevision > 0
          )
        );

        allow update: if canViewGroceryList(resource.data)
          && validPersonalGroceryList(request.resource.data)
          && canUpdateGroceryList(resource.data)
          && validGroceryRevisionUpdate()
          && (
            (
              // Default Grocery List:
              // Household members can update its permitted fields
              groceryListID == 'default'
              && canManageSharedGroceryList()
              && validDefaultGroceryList(request.resource.data)
              && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly([
                    'groceryListName',
                    'groceryListStatus',
                    'groceryListDescription',
                    'groceryListVisibility',
                    'ownerMemberID',
                    'visibleMemberIDs',
                    'groceryItemsRevision'
                  ])
              && request.resource.data.get(
                    'groceryListStatus',
                    'incomplete'
                  ) in [
                    'incomplete',
                    'defaultComplete',
                    'completeNoReset'
                  ]
            )
            ||
            (
              // Custom Grocery Lists:
              groceryListID != 'default'
              && validCustomGroceryList(request.resource.data)
              && validPersonalGroceryList(request.resource.data)
              && request.resource.data.ownerMemberID
                  == resource.data.ownerMemberID
              && (
                isGroceryListOwner()
                || request.resource.data.diff(resource.data)
                    .affectedKeys().hasOnly([
                      'groceryListStatus',
                      'groceryItemsRevision'
                    ])
              )
            )
          );

        allow delete: if groceryListID != 'default'
          && canManageSharedGroceryList()
          && isGroceryListOwner();

        allow get, list, delete: if isDeletingManager();

        match /items/{groceryItemID} {
          allow read: if canViewParentList();

          allow create: if (canEditParentListItems() || (
            canCreateItemInNewList()
            && canEditGroceryItems(getAfter(groceryListPath()).data)
            )
          ) && validGroceryItem(request.resource.data);

          allow update: if canEditParentListItems() && validGroceryItem(request.resource.data);

          allow delete: if groceryListID != 'default'
          && !groceryListID.matches('personal_.*')
          && canManageSharedGroceryList()
          && isGroceryListOwner();

          allow get, list, delete: if isDeletingManager();
        }
      }

      match /tasks/{taskID} {
        // Read the actual role from this household's membership.
        function taskMemberRole() {
          return get(
            /databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)
          ).data.memberRole;
        }

        function canManageTasks() {
          return taskMemberRole() in ['manager', 'member'];
        }

        function canViewTask(data) {
          let role = taskMemberRole();

          return role in ['manager', 'member', 'child']
            && (
              role == 'manager'
              || data.taskAssignedMemberIDs == []
              || data.createdByMemberID == request.auth.uid
              || request.auth.uid in data.taskAssignedMemberIDs
            );
        }

        // Check one selected assignee, if that position exists.
        function validAssigneeAt(ids, index) {
          return ids.size() <= index
            || (
              ids[index] is string
              && ids[index].size() > 0
              && !ids[index].matches('.*[/].*')
              && exists(
                /databases/$(database)/documents/households/$(householdID)/members/$(ids[index])
              )
            );
        }

        function validAssignees(ids) {
          return ids is list
            && ids.size() <= 8
            && ids.toSet().size() == ids.size()
            && validAssigneeAt(ids, 0)
            && validAssigneeAt(ids, 1)
            && validAssigneeAt(ids, 2)
            && validAssigneeAt(ids, 3)
            && validAssigneeAt(ids, 4)
            && validAssigneeAt(ids, 5)
            && validAssigneeAt(ids, 6)
            && validAssigneeAt(ids, 7);
        }

        // Validate the complete task document.
        function validTask(data) {
          let fields = [
            'taskName',
            'taskDescription',
            'taskStatus',
            'createdByMemberID',
            'completedByMemberID',
            'taskCompletionTime',
            'taskAssignedMemberIDs'
          ];

          return data.keys().hasAll(fields)
            && data.keys().hasOnly(fields)
            && data.taskName is string
            && data.taskName.size() > 0
            && data.taskName.size() <= 200
            && data.taskDescription is string
            && data.createdByMemberID is string
            && data.createdByMemberID.size() > 0
            && data.taskAssignedMemberIDs is list
            && data.taskAssignedMemberIDs.size() <= 8
            && (
              data.taskCompletionTime == null
              || data.taskCompletionTime is timestamp
            )
            && (
              (
                data.taskStatus == 'pending'
                && data.completedByMemberID == null
                && data.taskCompletionTime == null
              )
              || (
                data.taskStatus == 'completed'
                && data.completedByMemberID is string
                && data.completedByMemberID.size() > 0
              )
            );
        }

        // Editing cannot change the creator or completion details.
        function validTaskEdit() {
          let changes = request.resource.data.diff(resource.data)
            .affectedKeys();

          return canManageTasks()
            && changes.hasOnly([
              'taskName',
              'taskDescription',
              'taskAssignedMemberIDs'
            ])
            && (
              !changes.hasAny(['taskAssignedMemberIDs'])
              || (
                resource.data.createdByMemberID == request.auth.uid
                && validAssignees(
                  request.resource.data.taskAssignedMemberIDs
                )
              )
            );
        }

        function validTaskCompletion() {
          return resource.data.taskStatus == 'pending'
            && request.resource.data.taskStatus == 'completed'
            && request.resource.data.completedByMemberID
                == request.auth.uid
            && request.resource.data.taskCompletionTime
                == request.time
            && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly([
                  'taskStatus',
                  'completedByMemberID',
                  'taskCompletionTime'
                ])
            && (
              resource.data.taskAssignedMemberIDs == []
              || request.auth.uid in resource.data.taskAssignedMemberIDs
            );
        }

        allow read: if signedIn()
          && canViewTask(resource.data);

        allow create: if signedIn()
          && canManageTasks()
          && validTask(request.resource.data)
          && request.resource.data.taskStatus == 'pending'
          && request.resource.data.createdByMemberID == request.auth.uid
          && validAssignees(
            request.resource.data.taskAssignedMemberIDs
          );

        allow update: if signedIn()
          && canViewTask(resource.data)
          && validTask(request.resource.data)
          && (
            validTaskEdit()
            || validTaskCompletion()
          );

        allow delete: if signedIn()
          && canManageTasks()
          && canViewTask(resource.data);
      }

      match /pantryItems/{foodItemID} {
        function canEditPantry() {
          return isMember(householdID)
          && get(/databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)).data.memberRole in ['manager', 'member'];
        }
        

        allow read: if isMember(householdID);

        allow create: if canEditPantry()
          && request.resource.data.keys().hasAll([
            'foodName',
            'foodType',
            'foodQuantity',
            'foodStockStatus',
            'foodDescription'
          ])
          && request.resource.data.keys().hasOnly([
            'foodName',
            'foodType',
            'foodQuantity',
            'foodStockStatus',
            'foodDescription'
          ])
          && request.resource.data.foodName is string
          && request.resource.data.foodName.size() > 0
          && request.resource.data.foodType is string
          && request.resource.data.foodQuantity is int
          && request.resource.data.foodQuantity >= 0
          && request.resource.data.foodDescription is string
          && (
            (
              request.resource.data.foodQuantity > 0
              && request.resource.data.foodStockStatus == 'inStock'
            )
            ||
            (
              request.resource.data.foodQuantity == 0
              && request.resource.data.foodStockStatus == 'outOfStock'
            )
          );

        allow update: if canEditPantry()
          && request.resource.data.keys().hasOnly([
            'foodName',
            'foodType',
            'foodQuantity',
            'foodStockStatus',
            'foodDescription'
          ])
          && request.resource.data.foodName is string
          && request.resource.data.foodName.size() > 0
          && request.resource.data.foodType is string
          && request.resource.data.foodQuantity is int
          && request.resource.data.foodQuantity >= 0
          && request.resource.data.foodDescription is string
          && (
            (
              request.resource.data.foodQuantity > 0
              && request.resource.data.foodStockStatus == 'inStock'
            )
            ||
            (
              request.resource.data.foodQuantity == 0
              && request.resource.data.foodStockStatus == 'outOfStock'
            )
          );

        allow delete: if canEditPantry();
      }
    }
  }
}