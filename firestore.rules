rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(householdID) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)
        );
    }

    // Check whether this transaction creates a household
    // owned by the signed-in user.
    function createsHousehold(householdID) {
      return signedIn()
        && !exists(
          /databases/$(database)/documents/households/$(householdID)
        )
        && getAfter(
          /databases/$(database)/documents/households/$(householdID)
        ).data.creatorID == request.auth.uid;
    }

    // The user must already have a profile without a household.
    function hasNoHousehold() {
      let profile = get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;

      return profile.get('householdID', null) == null
        || profile.get('householdID', null) == '';
    }

    // Check the profile's household link after the transaction.
    function profileLinksTo(householdID) {
      return getAfter(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.householdID == householdID;
    }

    // Check the creator's membership after the transaction.
    function hasManagerMembershipAfter(householdID) {
      let member = getAfter(
        /databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)
      ).data;

      return member.userID == request.auth.uid
        && member.householdID == householdID
        && member.memberRole == 'manager';
    }

    function validProfile(data) {
      return data.keys().hasOnly([
          'username', 'email', 'displayName', 'householdID'
        ])
        && data.username is string
        && data.email is string
        && data.displayName is string
        && (
          data.get('householdID', null) == null
          || data.get('householdID', null) is string
        );
    }

    // Validate joining an existing household
    function joinsHousehold(householdID) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/households/$(householdID)
        )
        && hasNoHousehold()
        && profileLinksTo(householdID)
        && getAfter(
          /databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)
        ).data.userID == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)
        ).data.householdID == householdID
        && getAfter(
          /databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)
        ).data.memberRole == 'member';
    }

    match /users/{userID} {
      allow read: if signedIn() && request.auth.uid == userID;

      // Signup creates a profile without household membership.
      allow create: if signedIn()
        && request.auth.uid == userID
        && validProfile(request.resource.data)
        && request.resource.data.get('householdID', null) == null;

      // Keep the existing household link, or establish one
      // through a valid create or join transaction.
      allow update: if signedIn()
        && request.auth.uid == userID
        && validProfile(request.resource.data)
        && (
          request.resource.data.get('householdID', null)
            == resource.data.get('householdID', null)
          || (
            (
              resource.data.get('householdID', null) == null
              || resource.data.get('householdID', null) == ''
            )
            && request.resource.data.householdID is string
            && request.resource.data.householdID.size() > 0
            && (
              (
                createsHousehold(request.resource.data.householdID)
                && hasManagerMembershipAfter(
                  request.resource.data.householdID
                )
              )
              || joinsHousehold(request.resource.data.householdID)
            )
          )
        );
    }

    match /households/{householdID} {
      allow get: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'householdName', 'creatorID'
        ])
        && request.resource.data.householdName is string
        && request.resource.data.householdName.size() > 0
        && request.resource.data.creatorID == request.auth.uid
        && hasNoHousehold()
        && profileLinksTo(householdID)
        && hasManagerMembershipAfter(householdID);

      match /members/{memberID} {
        allow read: if isMember(householdID)
          || (signedIn() && memberID == request.auth.uid);

        // Creators become Managers; people joining become Members.
        allow create: if signedIn()
          && memberID == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'userID', 'householdID', 'memberRole', 'displayName'
          ])
          && request.resource.data.userID == request.auth.uid
          && request.resource.data.householdID == householdID
          && request.resource.data.displayName is string
          && request.resource.data.displayName == getAfter(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.displayName
          && (
            (
              request.resource.data.memberRole == 'manager'
              && createsHousehold(householdID)
              && hasNoHousehold()
              && profileLinksTo(householdID)
            )
            || (
              request.resource.data.memberRole == 'member'
              && joinsHousehold(householdID)
            )
          );

        match /personalItemsLists/{listID} {
          // Other household members cannot read this private list.
          allow read: if signedIn()
            && memberID == request.auth.uid
            && isMember(householdID);

          // Initialize the user's private list when creating or joining.
            allow create: if signedIn()
              && memberID == request.auth.uid
              && listID == 'default'
              && (
                createsHousehold(householdID)
                || joinsHousehold(householdID)
              )
              && request.resource.data.keys().hasOnly([
                'listName', 'listVisibility', 'ownerMemberID'
              ])
              && request.resource.data.listName == 'Personal Items'
              && request.resource.data.listVisibility == 'private'
              && request.resource.data.ownerMemberID == request.auth.uid;
          }
        }

      match /householdItemsLists/{listID} {
        allow read: if isMember(householdID);

        allow create: if listID == 'default'
          && createsHousehold(householdID)
          && request.resource.data.keys().hasOnly([
            'listName', 'listVisibility'
          ])
          && request.resource.data.listName == 'Household Items'
          && request.resource.data.listVisibility == 'shared';
      }

      match /groceryLists/{groceryListID} {
        allow read: if isMember(householdID);

        allow create: if groceryListID == 'default'
          && createsHousehold(householdID)
          && request.resource.data.keys().hasOnly([
            'groceryListName', 'groceryListVisibility', 'ownerMemberID'
          ])
          && request.resource.data.groceryListName == 'Grocery List'
          && request.resource.data.groceryListVisibility == 'shared'
          && request.resource.data.ownerMemberID == null;
        
        match /items/{groceryItemID} {
          allow read: if isMember(householdID);

          allow create, update: if isMember(householdID);

          allow delete: if isMember(householdID);
        }
      }

      match /tasks/{taskID} {
        // Read the actual role from this household's membership.
        function taskMemberRole() {
          return get(
            /databases/$(database)/documents/households/$(householdID)/members/$(request.auth.uid)
          ).data.memberRole;
        }

        function canManageTasks() {
          return taskMemberRole() in ['manager', 'member'];
        }

        function canViewTask(data) {
          let role = taskMemberRole();

          return role in ['manager', 'member', 'child']
            && (
              role == 'manager'
              || data.taskAssignedMemberIDs == []
              || data.createdByMemberID == request.auth.uid
              || request.auth.uid in data.taskAssignedMemberIDs
            );
        }

        // Check one selected assignee, if that position exists.
        function validAssigneeAt(ids, index) {
          return ids.size() <= index
            || (
              ids[index] is string
              && ids[index].size() > 0
              && !ids[index].matches('.*[/].*')
              && exists(
                /databases/$(database)/documents/households/$(householdID)/members/$(ids[index])
              )
            );
        }

        function validAssignees(ids) {
          return ids is list
            && ids.size() <= 8
            && ids.toSet().size() == ids.size()
            && validAssigneeAt(ids, 0)
            && validAssigneeAt(ids, 1)
            && validAssigneeAt(ids, 2)
            && validAssigneeAt(ids, 3)
            && validAssigneeAt(ids, 4)
            && validAssigneeAt(ids, 5)
            && validAssigneeAt(ids, 6)
            && validAssigneeAt(ids, 7);
        }

        // Validate the complete task document.
        function validTask(data) {
          let fields = [
            'taskName',
            'taskDescription',
            'taskStatus',
            'createdByMemberID',
            'completedByMemberID',
            'taskCompletionTime',
            'taskAssignedMemberIDs'
          ];

          return data.keys().hasAll(fields)
            && data.keys().hasOnly(fields)
            && data.taskName is string
            && data.taskName.size() > 0
            && data.taskName.size() <= 200
            && data.taskDescription is string
            && data.createdByMemberID is string
            && data.createdByMemberID.size() > 0
            && data.taskAssignedMemberIDs is list
            && data.taskAssignedMemberIDs.size() <= 8
            && (
              data.taskCompletionTime == null
              || data.taskCompletionTime is timestamp
            )
            && (
              (
                data.taskStatus == 'pending'
                && data.completedByMemberID == null
                && data.taskCompletionTime == null
              )
              || (
                data.taskStatus == 'completed'
                && data.completedByMemberID is string
                && data.completedByMemberID.size() > 0
              )
            );
        }

        // Editing cannot change the creator or completion details.
        function validTaskEdit() {
          let changes = request.resource.data.diff(resource.data)
            .affectedKeys();

          return canManageTasks()
            && changes.hasOnly([
              'taskName',
              'taskDescription',
              'taskAssignedMemberIDs'
            ])
            && (
              !changes.hasAny(['taskAssignedMemberIDs'])
              || (
                resource.data.createdByMemberID == request.auth.uid
                && validAssignees(
                  request.resource.data.taskAssignedMemberIDs
                )
              )
            );
        }

        function validTaskCompletion() {
          return resource.data.taskStatus == 'pending'
            && request.resource.data.taskStatus == 'completed'
            && request.resource.data.completedByMemberID
                == request.auth.uid
            && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly([
                  'taskStatus',
                  'completedByMemberID'
                ])
            && (
              resource.data.taskAssignedMemberIDs == []
              || request.auth.uid in resource.data.taskAssignedMemberIDs
            );
        }

        allow read: if signedIn()
          && canViewTask(resource.data);

        allow create: if signedIn()
          && canManageTasks()
          && validTask(request.resource.data)
          && request.resource.data.taskStatus == 'pending'
          && request.resource.data.createdByMemberID == request.auth.uid
          && validAssignees(
            request.resource.data.taskAssignedMemberIDs
          );

        allow update: if signedIn()
          && canViewTask(resource.data)
          && validTask(request.resource.data)
          && (
            validTaskEdit()
            || validTaskCompletion()
          );

        allow delete: if signedIn()
          && canManageTasks()
          && canViewTask(resource.data);
      }

      match /pantryItems/{foodItemID} {
        allow read: if isMember(householdID);

        allow create: if isMember(householdID)
          && request.resource.data.keys().hasAll([
            'foodName',
            'foodType',
            'foodQuantity',
            'foodStockStatus',
            'foodDescription'
          ])
          && request.resource.data.keys().hasOnly([
            'foodName',
            'foodType',
            'foodQuantity',
            'foodStockStatus',
            'foodDescription'
          ])
          && request.resource.data.foodName is string
          && request.resource.data.foodName.size() > 0
          && request.resource.data.foodType is string
          && request.resource.data.foodQuantity is int
          && request.resource.data.foodQuantity >= 0
          && request.resource.data.foodDescription is string
          && (
            (
              request.resource.data.foodQuantity > 0
              && request.resource.data.foodStockStatus == 'inStock'
            )
            ||
            (
              request.resource.data.foodQuantity == 0
              && request.resource.data.foodStockStatus == 'outOfStock'
            )
          );

        allow update: if isMember(householdID)
          && request.resource.data.keys().hasOnly([
            'foodName',
            'foodType',
            'foodQuantity',
            'foodStockStatus',
            'foodDescription'
          ])
          && request.resource.data.foodName is string
          && request.resource.data.foodName.size() > 0
          && request.resource.data.foodType is string
          && request.resource.data.foodQuantity is int
          && request.resource.data.foodQuantity >= 0
          && request.resource.data.foodDescription is string
          && (
            (
              request.resource.data.foodQuantity > 0
              && request.resource.data.foodStockStatus == 'inStock'
            )
            ||
            (
              request.resource.data.foodQuantity == 0
              && request.resource.data.foodStockStatus == 'outOfStock'
            )
          );

        allow delete: if isMember(householdID);
      }
    }
  }
}